<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/taskListFragment">

    <fragment
        android:id="@+id/taskListFragment"
        android:name="bg.mobileapps.fn2401321025.ui.list.TaskListFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_list_to_edit"
            app:destination="@id/taskEditFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/taskEditFragment"
        android:name="bg.mobileapps.fn2401321025.ui.edit.TaskEditFragment"
        android:label="@string/title_new_task">
        <argument
            android:name="taskId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>
</navigation>
